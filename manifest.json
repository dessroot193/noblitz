{
  "manifest_version": 3,
  "name": "NoBlitz",
  "version": "0.1",
  "description": "Firefox extension for Chess.com and Lichess to make you focus on playing longer time controls",
  "icons": {
    "48": "icons/border-48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "noblitz@mozilla.org",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/*"
      ],
      "js": [
        "chesscom.js"
      ]
    },
    {
      "matches": [
        "*://*.lichess.org/*"
      ],
      "js": [
        "lichess.js"
      ]
    }
  ]
}