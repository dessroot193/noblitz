{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 3,
  "version": "0.0.2",
  "firefox:browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "NoBlitz",
  "description": "Browser extension to make you focus on playing more meaningful chess",
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "64": "images/icon.png",
    "128": "images/icon.png"
  },
  "chromium:action": {
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "64": "images/icon.png",
      "128": "images/icon.png"
    },
    "default_title": "NoBlitz"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/*"
      ],
      "js": [
        "chesscom.js",
        "config.js",
        "utils.js",
        "noblitz.css"
      ]
    },
    {
      "matches": [
        "*://*.lichess.org/*"
      ],
      "js": [
        "config.js",
        "lichess.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/blocker.png"],
      "matches": ["<all_urls>"]
    }
  ]
}